# Normalise to LF in the repository, so a checkout on Windows and a build on
# Linux CI agree and nobody sees every file as modified after a clone.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and don't count toward language stats.
package-lock.json linguist-generated=true -diff
